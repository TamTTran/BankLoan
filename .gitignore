# ──────────────────────────────────────────────────────
# .gitignore — LoanFlow Lite (.NET 8 + Vite/Node frontend)
# ──────────────────────────────────────────────────────

# ── Visual Studio ─────────────────────────────────────
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.userprefs

# ── Build output ───────────────────────────────────────
[Dd]ebug/
[Rr]elease/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
out/

# ── .NET / NuGet ──────────────────────────────────────
*.nupkg
*.snupkg
*.nuget.props
*.nuget.targets
project.lock.json
project.fragment.lock.json
packages/
!packages/build/

# ── Secrets & environment ─────────────────────────────
appsettings.Development.json
appsettings.Local.json
appsettings.Production.json
appsettings.Staging.json
*.pfx
*.p12
*.pem
*.key
secrets.json
.env
.env.*
!.env.example

# ── Entity Framework Migrations ───────────────────────
# Migrations are tracked in git — do NOT add Migrations/ here
# But ignore the design-time build cache
*.dtbcache.v2

# ── Rider / JetBrains ─────────────────────────────────
.idea/
*.sln.iml
_ReSharper*/
*.ReSharper

# ── VSCode ────────────────────────────────────────────
.vscode/settings.json
.vscode/launch.json
.vscode/tasks.json
!.vscode/extensions.json

# ── Test results ──────────────────────────────────────
TestResults/
coverage/
*.coveragexml
*.trx
*.coverage

# ── Node / Frontend ────────────────────────────────────
node_modules/
dist/
.next/
.nuxt/
.output/
.cache/
.parcel-cache/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Docker ────────────────────────────────────────────
.docker/

# ── OS ────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
ehthumbs.db

# ── Misc ──────────────────────────────────────────────
*.bak
*.tmp
*.swp
*.orig
*.log
