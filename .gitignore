# ──────────────────────────────────────────────────────
# .gitignore — LoanFlow Lite (.NET 8 + Vite/Node frontend)
# ──────────────────────────────────────────────────────

# ── Visual Studio ─────────────────────────────────────
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.userprefs


# ── Build output ───────────────────────────────────────────────────────────────
# Kết quả build (Debug & Release) — dùng ** để bắt mọi cấp thư mục
**/bin/
**/obj/
**/log/
**/logs/
out/
publish/

# Incremental build cache (MSBuild)
*.FileListAbsolute.txt
*.FrameworkListFile.txt
AssemblyInfo.cs        # auto-generated
**/GeneratedFiles/

# ── Debug ──────────────────────────────────────────────────────────────────────
# Symbol / debug files
*.pdb
*.ilk
*.idb
*.ipdb

# Crash dumps & memory snapshots
*.dmp
*.mdmp
*.psess
*.vsp
*.vspx
*.sap

# .NET diagnostic / profiler traces
*.diagsession
*.etl
*.nettrace

# Hot reload / fast refresh
.hotreload/
**/Properties/launchSettings.local.json
launchSettings.override.json

# User Secrets (lưu ngoài project folder, nhưng phòng trường hợp copy vào)
secrets.json

# SQLite dev/test database (nếu dùng InMemory hoặc SQLite khi debug)
*.db
*.db-shm
*.db-wal
*.db3
*.sqlite
*.sqlite3

# EF Core design-time build cache
*.dtbcache.v2
**/obj/**/*.cs            # generated source từ EF/Razor

# SQL Server LocalDB (file .mdf/.ldf tạo ra khi chạy local)
*.mdf
*.ldf
*.mdf-journal

# App data / runtime folders tạo khi chạy debug
**/App_Data/
wwwroot/uploads/


# ── .NET / NuGet ──────────────────────────────────────
*.nupkg
*.snupkg
*.nuget.props
*.nuget.targets
project.lock.json
project.fragment.lock.json
project.assets.json
**/*.csproj.nuget.dgspec.json
**/*.nuget.cache
packages/
!packages/build/

# ── Secrets & environment ─────────────────────────────
# appsettings có thông tin môi trường cụ thể — không commit
**/appsettings.Development.json
**/appsettings.Local.json
**/appsettings.Production.json
**/appsettings.Staging.json
*.pfx
*.p12
*.pem
*.key
secrets.json
.env
.env.*
!.env.example

# ── Entity Framework Migrations ───────────────────────
# Migrations are tracked in git — do NOT add Migrations/ here
# But ignore the design-time build cache
*.dtbcache.v2

# ── Rider / JetBrains ─────────────────────────────────
.idea/
*.sln.iml
_ReSharper*/
*.ReSharper

# ── VSCode ────────────────────────────────────────────
.vscode/settings.json
.vscode/launch.json
.vscode/tasks.json
!.vscode/extensions.json

# ── Test results ──────────────────────────────────────
TestResults/
coverage/
*.coveragexml
*.trx
*.coverage

# ── Node / Frontend ────────────────────────────────────
node_modules/
dist/
.next/
.nuxt/
.output/
.cache/
.parcel-cache/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Docker ────────────────────────────────────────────
.docker/

# ── OS ────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
ehthumbs.db

# ── Misc ──────────────────────────────────────────────
*.bak
*.tmp
*.swp
*.orig
*.log
