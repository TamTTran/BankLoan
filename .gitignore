# ════════════════════════════════════════════════════════════════════════════
#  LoanFlow Lite — .gitignore
#  Covers: .NET 8, ASP.NET Core, EF Core, React/Vite, Docker, IDE, OS
# ════════════════════════════════════════════════════════════════════════════


# ── SECRETS & ENVIRONMENT (NEVER commit these) ──────────────────────────────
.env
.env.*
!.env.example
secrets.json
appsettings.Development.json
appsettings.Local.json
appsettings.Production.json
appsettings.Staging.json
**/appsettings.Development.json
**/appsettings.Local.json
**/appsettings.Production.json
**/appsettings.Staging.json

# TLS / PKI — private keys & certificates
*.pem
*.key
*.p12
*.pfx
*.csr
*.crt
*.srl
certs/*.key
certs/*.crt
certs/*.csr
certs/*.pem
certs/*.srl

# User Secrets (dotnet user-secrets)
**/Properties/secrets.json


# ── .NET BUILD OUTPUT ────────────────────────────────────────────────────────
**/bin/
**/obj/
**/out/
publish/

# MSBuild incremental build cache
*.FileListAbsolute.txt
*.FrameworkListFile.txt
**/GeneratedFiles/

# EF Core design-time cache
*.dtbcache.v2

# NuGet
*.nupkg
*.snupkg
packages/
!packages/build/
# Restored packages (dotnet restore re-creates these)
**/*.csproj.nuget.dgspec.json
**/*.nuget.cache
project.lock.json
project.fragment.lock.json
project.assets.json


# ── .NET RUNTIME & TOOLING ──────────────────────────────────────────────────
# SDK telemetry & local tool manifests (machine-specific)
.dotnet/
.dotnet-cli/
.dotnet-tools/
.buildtmp/

# Hot reload state
.hotreload/
**/Properties/launchSettings.local.json
launchSettings.override.json

# Debug symbols & crash artefacts
*.pdb
*.ilk
*.idb
*.ipdb
*.dmp
*.mdmp
*.nettrace
*.diagsession
*.etl
*.psess
*.vsp
*.vspx
*.sap


# ── DATABASE ─────────────────────────────────────────────────────────────────
# SQLite dev/test
*.db
*.db-shm
*.db-wal
*.db3
*.sqlite
*.sqlite3

# SQL Server LocalDB
*.mdf
*.ldf
*.mdf-journal

# Database dumps / backups (generated by Ofelia in docker-compose)
backups/
*.sql.gz
# Keep schema.sql tracked (if you maintain it manually)
# *.sql

# App upload / runtime data
**/App_Data/
wwwroot/uploads/


# ── FRONTEND (React / Vite / Node) ───────────────────────────────────────────
node_modules/
frontend/node_modules/
dist/
frontend/dist/
.next/
.nuxt/
.output/
.cache/
.parcel-cache/
.vite/
frontend/.vite/
*.local

# Dependency debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*


# ── IDE — VISUAL STUDIO ──────────────────────────────────────────────────────
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.userprefs
*.VC.db
*.VC.opendb


# ── IDE — JETBRAINS (Rider / IntelliJ) ──────────────────────────────────────
.idea/
*.sln.iml
_ReSharper*/
*.ReSharper
*.DotSettings.user
# Keep *.DotSettings if your team shares code-style settings
# *.DotSettings


# ── IDE — VSCODE ─────────────────────────────────────────────────────────────
# Keep extensions.json so teammates get recommended extensions
.vscode/settings.json
.vscode/launch.json
.vscode/tasks.json
!.vscode/extensions.json


# ── TEST RESULTS ─────────────────────────────────────────────────────────────
TestResults/
coverage/
*.coveragexml
*.trx
*.coverage


# ── DOCKER ───────────────────────────────────────────────────────────────────
# Local override files (machine-specific ports / volumes)
docker-compose.override.local.yml
.docker/


# ── LOGGING (runtime log files) ──────────────────────────────────────────────
**/logs/
**/log/
*.log
.run-api.out.log
.run-api.err.log


# ── SCRATCH / TEMP ───────────────────────────────────────────────────────────
scratch/
*.tmp
*.bak
*.swp
*.orig
output.txt


# ── AI AGENT WORKSPACE ───────────────────────────────────────────────────────
.gemini/
.claude/


# ── OPERATING SYSTEM ─────────────────────────────────────────────────────────
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~


# ── WHAT IS INTENTIONALLY TRACKED ────────────────────────────────────────────
# (reminder — these are NOT in .gitignore)
#
#  ✅ src/**/*.cs                — Source code
#  ✅ src/**/*.csproj            — Project files
#  ✅ LoanFlow.sln               — Solution file
#  ✅ global.json                — SDK pin
#  ✅ docker-compose.yml         — Base compose
#  ✅ docker-compose.override.yml— Dev compose (ports, volumes)
#  ✅ Dockerfile                 — Container build
#  ✅ nginx.conf                 — Reverse proxy config
#  ✅ prometheus.yml             — Metrics config
#  ✅ grafana/                   — Dashboard provisioning
#  ✅ .env.example               — Env var documentation (no real values)
#  ✅ .vscode/extensions.json    — Recommended extensions
#  ✅ scripts/                   — Utility scripts
#  ✅ docs/                      — Documentation
#  ✅ src/**/Migrations/         — EF Core migrations
#  ✅ README.md                  — This file
