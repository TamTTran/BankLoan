# ════════════════════════════════════════════════════════════════════════════
#  LoanFlow Lite — .env.example
#  Copy sang .env rồi điền giá trị thực. KHÔNG commit .env lên Git.
#  Để tạo secret ngẫu nhiên: openssl rand -base64 48
# ════════════════════════════════════════════════════════════════════════════


# ── DATABASE ─────────────────────────────────────────────────────────────────
# MySQL root password (tối thiểu 16 ký tự)
DB_ROOT_PASSWORD=your_secure_root_password_here

# MySQL app-user password (user = loanflow)
DB_PASSWORD=your_secure_db_password_here


# ── JWT ──────────────────────────────────────────────────────────────────────
# Signing key cho JWT token (tối thiểu 32 ký tự, nên dùng 48+)
# Tạo: openssl rand -base64 48
JWT_KEY=your_secure_jwt_signing_key_here_min_32_chars


# ── DEPLOYMENT IDENTITY ───────────────────────────────────────────────────────
# URL public của web app (dùng cho CORS, cookie domain)
PUBLIC_APP_ORIGIN=https://app.loanflow.example

# Hostname whitelist (AllowedHosts)
ALLOWED_HOSTS=app.loanflow.example

# IP của Nginx / Load Balancer (để X-Forwarded-For hoạt động đúng)
TRUSTED_PROXY_IP=10.0.0.10


# ── WEBHOOK ───────────────────────────────────────────────────────────────────
# HMAC secret dùng để verify webhook từ Virtual Account / Core Banking
# Tạo: openssl rand -hex 32
WEBHOOK_SECRET=replace_with_crypto_random_webhook_secret
WEBHOOK_SYSTEM_ACTOR_USERNAME=system-webhook


# ── FEATURE FLAGS (Mock/Real toggle) ─────────────────────────────────────────
# true  = dùng Mock (không cần credentials, chạy offline)
# false = dùng dịch vụ thực (phải điền credentials bên dưới)
USE_MOCK_PAYMENT_GATEWAY=true
USE_MOCK_SMS=true
USE_MOCK_CIC=true
USE_MOCK_EKYC=true
USE_MOCK_CERTIFICATE_AUTHORITY=true


# ── NAPAS (Thanh toán liên ngân hàng & Giải ngân) ────────────────────────────
# Chỉ đọc khi USE_MOCK_PAYMENT_GATEWAY=false
# Đăng ký tại: https://napas.com.vn/merchant
NAPAS_API_URL=https://sandbox.napas.com.vn/api
NAPAS_API_KEY=replace_with_napas_api_key
NAPAS_CALLBACK_SECRET=replace_with_napas_callback_hmac_secret
# Timeout mỗi request (giây)
NAPAS_TIMEOUT_SECONDS=10
# Số lần retry khi gặp lỗi mạng (Polly)
NAPAS_MAX_RETRY_ATTEMPTS=3
# Delay cơ sở giữa các lần retry (ms, tăng dần theo exponential backoff)
NAPAS_RETRY_BASE_DELAY_MS=1000
# Môi trường: sandbox | production
NAPAS_ENVIRONMENT=sandbox


# ── PCB / CIC (Tra cứu lịch sử tín dụng) ────────────────────────────────────
# Chỉ đọc khi USE_MOCK_CIC=false
# Đăng ký tại: https://pcb.com.vn (PCB — Vietnam Credit Bureau)
PCB_API_URL=https://api.pcb.com.vn/v2
PCB_API_KEY=replace_with_pcb_api_key


# ── FPT eKYC (Xác minh danh tính điện tử) ───────────────────────────────────
# Chỉ đọc khi USE_MOCK_EKYC=false
# Đăng ký tại: https://ekyc.fpt.ai
FPT_EKYC_API_URL=https://ekyc.fpt.ai/api/v2
FPT_EKYC_API_KEY=replace_with_fpt_ekyc_api_key


# ── TWILIO (SMS / OTP) ────────────────────────────────────────────────────────
# Chỉ đọc khi USE_MOCK_SMS=false
# Đăng ký tại: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace_with_twilio_auth_token
# Số điện thoại Twilio (E.164 format, ví dụ: +84901234567)
TWILIO_FROM_NUMBER=+84901234567


# ── CERTIFICATE AUTHORITY (eContract ký số) ──────────────────────────────────
# Chỉ đọc khi USE_MOCK_CERTIFICATE_AUTHORITY=false
# Tích hợp với CA được VNPT hoặc Viettel cấp phép
CERTIFICATE_AUTHORITY_API_URL=https://ca-provider.example/api/sign
CERTIFICATE_AUTHORITY_API_KEY=replace_with_ca_api_key


# ── SEED DATA (Tạo user mặc định khi khởi động lần đầu) ──────────────────────
# Nếu để trống, hệ thống tự tạo password ngẫu nhiên và in ra log
SEED_ADMIN_PASSWORD=LoanFlow@2026!
SEED_OFFICER_PASSWORD=LoanFlow@2026!
SEED_APPROVER_PASSWORD=LoanFlow@2026!
SEED_MANAGER_PASSWORD=LoanFlow@2026!
SEED_COLLECTOR_PASSWORD=LoanFlow@2026!
