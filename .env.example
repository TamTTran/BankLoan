# ──────────────────────────────────────────────────────
# .env.example  —  copy to .env and fill in values
# ──────────────────────────────────────────────────────
# DO NOT use these placeholder values in production.
# Generate strong random secrets for each environment.

# MySQL root password (min 16 chars, use a password manager)
DB_ROOT_PASSWORD=your_secure_root_password_here

# MySQL app user password (user = loanflow)
DB_PASSWORD=your_secure_db_password_here

# JWT signing key (min 32 chars, crypto-random recommended)
# Example: openssl rand -base64 48
JWT_KEY=your_secure_jwt_signing_key_here_min_32_chars

# Public deployment identity
PUBLIC_APP_ORIGIN=https://app.loanflow.example
ALLOWED_HOSTS=app.loanflow.example
TRUSTED_PROXY_IP=10.0.0.10

# Webhook signing and audit actor
WEBHOOK_SECRET=replace_with_crypto_random_webhook_secret
WEBHOOK_SYSTEM_ACTOR_USERNAME=system-webhook

# Production integrations. Keep all USE_MOCK_* values false in production.
USE_MOCK_PAYMENT_GATEWAY=false
USE_MOCK_SMS=false
USE_MOCK_CIC=false
USE_MOCK_EKYC=false
USE_MOCK_CERTIFICATE_AUTHORITY=false
NAPAS_API_URL=https://napas-provider.example
NAPAS_API_KEY=replace_with_secret
PCB_API_URL=https://pcb-provider.example
PCB_API_KEY=replace_with_secret
FPT_EKYC_API_URL=https://ekyc-provider.example
FPT_EKYC_API_KEY=replace_with_secret
CERTIFICATE_AUTHORITY_API_URL=https://ca-provider.example/sign
CERTIFICATE_AUTHORITY_API_KEY=replace_with_secret
TWILIO_ACCOUNT_SID=replace_with_secret
TWILIO_AUTH_TOKEN=replace_with_secret
TWILIO_FROM_NUMBER=replace_with_sender
